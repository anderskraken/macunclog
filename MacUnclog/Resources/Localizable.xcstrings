    "MacUnclog" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog"
          }
        }
      }
    },
    "MacUnclog checks free space every 15 minutes. If it falls below the threshold, the app cleans up and notifies you, at most once every 6 hours." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog sjekker ledig plass hvert kvarter. Faller den under grensen, rydder appen og varsler deg, men høyst én gang hver sjette time."
          }
        }
      }
    },
    "MacUnclog doesn’t touch this process" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog rører ikke denne prosessen"
          }
        }
      }
    },
    "MacUnclog found nothing safe to delete" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog fant ingenting trygt å slette"
          }
        }
      }
    },
    "MacUnclog freed up %@" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog frigjorde %@"
          }
        }
      }
    },
    "MacUnclog isn’t allowed to touch %@." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog har ikke lov til å røre %@."
          }
        }
      }
    },
    "MacUnclog looks for caches and build files, and checks that nothing is in use before it deletes anything." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog leter etter cacher og byggrester og sjekker at ingenting er i bruk før noe slettes."
          }
        }
      }
    },
    "MacUnclog never deletes anything in these folders, in addition to Documents, Desktop, Downloads, Pictures, Movies, Music and iCloud Drive." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog sletter aldri noe i disse mappene. Det samme gjelder Dokumenter, Skrivebord, Nedlastinger, Bilder, Filmer, Musikk og iCloud Drive."
          }
        }
      }
    },
    "MacUnclog then sits in the menu bar and shows whether your Mac is doing fine." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da ligger MacUnclog i menylinjen og viser om Macen har det bra."
          }
        }
      }
    },
