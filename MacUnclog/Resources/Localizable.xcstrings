    "MacUnclog is up to date" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog er oppdatert"
          }
        }
      }
    },
    "MacUnclog isn’t allowed to control %@. You can allow it in System Settings > Privacy & Security > Automation." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog har ikke lov til å styre %@. Du kan tillate det i Systeminnstillinger > Personvern og sikkerhet > Automatisering."
          }
        }
      }
    },
    "MacUnclog isn’t allowed to touch %@." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog har ikke lov til å røre %@."
          }
        }
      }
    },
    "MacUnclog looks for caches and build files, and checks that nothing is in use before it deletes anything." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog leter etter cacher og byggrester og sjekker at ingenting er i bruk før noe slettes."
          }
        }
      }
    },
    "MacUnclog never deletes anything in these folders, in addition to Documents, Desktop, Downloads, Pictures, Movies, Music and iCloud Drive." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog sletter aldri noe i disse mappene. Det samme gjelder Dokumenter, Skrivebord, Nedlastinger, Bilder, Filmer, Musikk og iCloud Drive."
          }
        }
      }
    },
    "MacUnclog never suggests quitting these apps. To add one, right-click a suggested Quit button, or use the … menu under Apps in Overview." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog foreslår aldri å avslutte disse appene. Du legger til en ved å høyreklikke en foreslått Avslutt-knapp, eller med …-menyen under Apper i Oversikt."
          }
        }
      }
    },
    "MacUnclog skill" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog-skill"
          }
        }
      }
