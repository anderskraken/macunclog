    "MacUnclog %@ is available" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog %@ er tilgjengelig"
          }
        }
      }
    },
    "MacUnclog asks GitHub once a day for the newest version. It never downloads or installs anything by itself." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog spør GitHub om nyeste versjon én gang om dagen. Appen laster aldri ned eller installerer noe på egen hånd."
          }
        }
      }
    },
    "MacUnclog checks free space every 15 minutes. If it falls below the threshold, the app cleans up and notifies you, at most once every 6 hours." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog sjekker ledig plass hvert kvarter. Faller den under grensen, rydder appen og varsler deg, men høyst én gang hver sjette time."
          }
        }
      }
    },
    "MacUnclog couldn’t read the tabs in %@." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog kunne ikke lese fanene i %@."
          }
        }
      }
    },
    "MacUnclog doesn’t touch this process" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacUnclog rører ikke denne prosessen"
          }
        }
